{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend de la aplicación de música con Express y Sequelize",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all"
  },
  "dependencies": {
    "axios": "^1.8.2",
    "bcryptjs": "^3.0.2",
    "controllers": "^0.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "pg": "^8.10.0",
    "pg-hstore": "^2.3.4",
    "process": "^0.11.10",
    "sequelize": "^6.28.0",
    "sequelize-cli": "^6.6.0",
    "stripe": "^17.7.0"
  },
  "author": "Grupo Sally-Floyd",
  "license": "MIT",
  "imports": {
    "#src/*": "./src/*.js",
    "#controllers/*": "./src/controllers/*.js",
    "#routes/*": "./src/routes/*.js",
    "#models/*": "./src/models/*.js",
    "#config/*": "./config/*.js"
  },
  "engines": {
    "node": "22.14.0"
  }
}
