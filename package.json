{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend de la aplicación de música con Express y Sequelize",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "test": "npm run test-clean && npm run test-user && npm run test-artist && npm run test-songs && npm run test-playlist && npm run test-stripe && npm run test-song_like && npm run test-social && npm run test-player && npm run test-clean",
    "test-artist": "jasmine --random=false src/test/artist.test.js",
    "test-user": "jasmine --random=false src/test/user.test.js",
    "test-songs": "jasmine --random=false src/test/songs.test.js",
    "test-playlist": "jasmine --random=false src/test/playlists.test.js",
    "test-stripe": "jasmine --random=false src/test/stripe.test.js",
    "test-song_like": "jasmine --random=false src/test/song_like.test.js",
    "test-player": "jasmine --random=false src/test/player.test.js",
    "test-social": "jasmine --random=false src/test/social.test.js",
    "test-clean": "node src/test/clean.js"
  },
  "dependencies": {
    "axios": "^1.8.3",
    "bcryptjs": "^3.0.2",
    "controllers": "^0.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "jasmine": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.10.0",
    "pg-hstore": "^2.3.4",
    "process": "^0.11.10",
    "sequelize": "^6.28.0",
    "sequelize-cli": "^6.6.0",
    "stripe": "^17.7.0",
    "supertest": "^7.1.0",
    "swagger-jsdoc": "^6.2.8",
    "widdershins": "^4.0.1"
  },
  "author": "Grupo Sally-Floyd",
  "license": "MIT",
  "imports": {
    "#src/*": "./src/*.js",
    "#controllers/*": "./src/controllers/*.js",
    "#routes/*": "./src/routes/*.js",
    "#models/*": "./src/models/*.js",
    "#config/*": "./config/*.js",
    "#test/*": "./src/test/*.js",
    "#ip/*": "./src/get_ip.js"
  },
  "engines": {
    "node": "22.14.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9"
  }
}
